    if (reduceMotion) { vb = target; applyVB(); layout(); return; }
    var from = { x: vb.x, y: vb.y, w: vb.w, h: vb.h }, t0 = performance.now(), D = 650;
    function step(t) {
      var k = Math.min(1, (t - t0) / D), e = k < .5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
      vb = { x: from.x + (target.x - from.x) * e, y: from.y + (target.y - from.y) * e, w: from.w + (target.w - from.w) * e, h: from.h + (target.h - from.h) * e };
      applyVB(); layout(); anim = k < 1 ? requestAnimationFrame(step) : null;
    }
    anim = requestAnimationFrame(step);
  }
  var btnAll = document.getElementById("viewAll"), btnPack = document.getElementById("viewPack");
  function viewBox() { return view === "all" ? M.home : packBox(M.pad + 20, M.camMin * 1.6); }
  function setView(v, instant) {
    view = v; btnAll.setAttribute("aria-pressed", v === "all"); btnPack.setAttribute("aria-pressed", v === "pack");
    if (instant) { if (anim) cancelAnimationFrame(anim); vb = viewBox(); applyVB(); layout(); } else animateVB(viewBox());
  }
  btnAll.addEventListener("click", function () { setView("all"); });
  btnPack.addEventListener("click", function () { setView("pack"); });
 
  var btnSolo = document.getElementById("modeSolo"), btnTeam = document.getElementById("modeTeam");
  function setMode(m) {
    if (replaying) return;
    mode = m; M = MODES[m]; selected = null; hideTip();
    btnSolo.setAttribute("aria-pressed", m === "solo"); btnTeam.setAttribute("aria-pressed", m === "team");
    document.getElementById("mapDesc").textContent = M.desc;
    document.getElementById("routeLine").innerHTML = "Total route: <strong>" + fmt(M.route.km) + " km</strong> ≈ <strong>" + fmt(M.steps) + " steps</strong> · " + ents().length + " " + M.noun;
    current = positions(DATA_DAY);
    buildStatic(); buildPins(); setView(view, true); renderTeams();
  }
  btnSolo.addEventListener("click", function () { setMode("solo"); });
  btnTeam.addEventListener("click", function () { setMode("team"); });
 
  // Replay: the camera follows the pack, keeping every pin in view
  var replayBtn = document.getElementById("replay"), dayBadge = document.getElementById("dayBadge");
  function lock(on) { replaying = on; [replayBtn, btnAll, btnPack, btnSolo, btnTeam].forEach(function (b) { b.disabled = on; }); }
  replayBtn.addEventListener("click", function () {
    hideTip(); if (anim) { cancelAnimationFrame(anim); anim = null; }
    if (!current.length) return;
    lock(true); dayBadge.hidden = false;
    current = positions(0); vb = packBox(M.pad, M.camMin); applyVB();
    var t0 = performance.now(), D = 1600 + DATA_DAY * 420, hold = 500;
    function step(t) {
      var k = Math.max(0, Math.min(1, (t - t0 - hold) / D)), day = k * DATA_DAY;
      current = positions(day);
      var target = packBox(M.pad, M.camMin), s = 0.12;
      vb = containAll({ x: vb.x + (target.x - vb.x) * s, y: vb.y + (target.y - vb.y) * s, w: vb.w + (target.w - vb.w) * s, h: vb.h + (target.h - vb.h) * s }, M.round ? 8 : 20);
      applyVB();
      var d = Math.max(1, Math.ceil(day));
      dayBadge.textContent = "Day " + d + " · " + dateAt(d - 1, true);
      layout();
      if (k < 1) { requestAnimationFrame(step); return; }
      lock(false);
      setTimeout(function () { dayBadge.hidden = true; setView(view); }, 1400);
    }
    requestAnimationFrame(step);
  });
 
  // =====================================================================
  //  Team leaderboard
  // =====================================================================
  var teamList = document.getElementById("teamList"), expanded = new Set();
  function renderTeams() {
    document.getElementById("teamCount").textContent = teams.length + " teams";
    if (!teams.length) { teamList.innerHTML = '<div class="empty">No teams in the sheet yet.</div>'; return; }
    var lead = Math.max(1, teamsSorted[0].total);
    teamList.innerHTML = teamsSorted.map(function (t) {
      var c = t.rank <= 5 && t.total > 0 ? COLORS[t.rank - 1] : "var(--pin-other)", open = expanded.has(t.key);
      var ms = t.members.slice().sort(function (a, b) { return b.total - a.total; }), maxM = ms.length ? Math.max(1, ms[0].total) : 1;
      var mem = open ? '<div class="members">' + (ms.length ? ms.map(function (p) {
        return '<div class="member"><div><span>' + esc(p.name) + ' <span class="move same">#' + p.rank + ' overall</span></span><div class="bar"><i style="width:' + (p.total / maxM * 100).toFixed(1) + '%;background:' + c + '"></i></div></div><span class="num">' + fmt(p.total) + '</span></div>';
      }).join("") : '<div class="t-where">No walkers listed for this team in the People table yet.</div>') + '</div>' : '';
      var where = t.total > 0 ? whereOn(TEAM_ROUTE, t.km) : "No steps reported yet";
      return '<div class="team' + (selected === t ? ' sel' : '') + '">' +
        '<button type="button" class="team-row" data-key="' + t.key + '" aria-expanded="' + open + '">' +
        '<span class="badge" style="background:' + c + '">' + t.rank + '</span>' +
        '<span class="t-main"><span class="t-name">' + esc(t.name) + ' <small>' + (t.memberCount || t.members.length) + ' walkers</small></span>' +
        '<span class="bar"><i style="width:' + (t.total / lead * 100).toFixed(1) + '%;background:' + c + '"></i></span>' +
        '<span class="t-where">' + where + '</span></span>' +
        '<span class="t-nums"><strong class="num">' + fmt(t.total) + '</strong><span class="num">' + fmt(t.km) + ' km · week ' + REPORTED + ': ' + fmt(t.weeks[REPORTED - 1]) + '</span>' + moveHtml(t.move) + '</span>' +
        '</button>' + mem + '</div>';
    }).join("");
  }
  teamList.addEventListener("click", function (ev) {
    var row = ev.target.closest(".team-row"); if (!row) return;
    var t = teams.find(function (x) { return x.key === row.dataset.key; }); if (!t) return;
    if (expanded.has(t.key)) expanded.delete(t.key); else expanded.add(t.key);
    if (mode === "team") select(t, false); else renderTeams();
  });
  function select(e, fromMap) {
    selected = e;
    if (e.kind === "team") {
      if (fromMap) expanded.add(e.key);
      renderTeams();
      if (fromMap) { var row = teamList.querySelector('[data-key="' + e.key + '"]'); if (row) teamList.scrollTo({ top: row.parentNode.offsetTop - 8, behavior: reduceMotion ? "auto" : "smooth" }); }
    } else if (fromMap) {
      search.value = ""; filter.value = ""; renderPeople();
      var r = document.getElementById("row-" + e.key), wrap = document.getElementById("peopleWrap");
      if (r) { wrap.scrollTo({ top: r.offsetTop - 60, behavior: reduceMotion ? "auto" : "smooth" }); r.classList.remove("flash"); void r.offsetWidth; r.classList.add("flash"); }
    }
    drawPins(); showTip(e);
  }
 
  // =====================================================================
  //  Individual leaderboard
  // =====================================================================
  var body = document.getElementById("peopleBody"), search = document.getElementById("peopleSearch"), filter = document.getElementById("teamFilter");
  (function () {
    var h = '<th>#</th><th>Walker</th>';
    for (var w = 0; w < WEEKS; w++) h += '<th class="r">Week ' + (w + 1) + '<small>' + dateAt(w * 7) + ' – ' + dateAt(w * 7 + 6) + '</small></th>';
    h += '<th class="r">Daily avg</th><th class="r">Total steps</th>';
    document.getElementById("peopleHead").innerHTML = h;
  })();
  function fillFilter() {
    var keep = filter.value;
    filter.innerHTML = '<option value="">All walkers</option><option value="__solo">Individual entries (no team)</option>' +
      teams.slice().sort(function (a, b) { return a.name.localeCompare(b.name); }).map(function (t) { return '<option value="' + esc(t.key) + '">' + esc(t.name) + '</option>'; }).join("");
    filter.value = keep;
    if (filter.value !== keep) filter.value = "";
  }
  function renderPeople() {
    var q = search.value.trim().toLowerCase(), f = filter.value;
    var list = peopleSorted.filter(function (p) {
      if (q && p.name.toLowerCase().indexOf(q) === -1) return false;
      if (f === "__solo") return !p.team;
      if (f) return p.team && p.team.key === f;
      return true;
    });
    document.getElementById("peopleCount").textContent = "Showing " + list.length + " of " + people.length + " walkers";
    if (!list.length) { body.innerHTML = '<tr><td colspan="' + (WEEKS + 4) + '" class="empty">' + (people.length ? 'No walkers match. Try another name or team.' : 'No walkers in the sheet yet.') + '</td></tr>'; return; }
    body.innerHTML = list.map(function (p) {
      var cells = "";
      for (var w = 0; w < WEEKS; w++) cells += w < REPORTED ? '<td class="r num">' + (p.raw[w] === null ? '<span class="pending">–</span>' : fmt(p.weeks[w])) + '</td>' : '<td class="r pending">Due ' + dateAt((w + 1) * 7) + '</td>';
      return '<tr id="row-' + p.key + '">' +
        '<td><span class="rank' + (p.rank <= 3 && p.total > 0 ? " r" + p.rank : "") + '">' + p.rank + '</span></td>' +
        '<td><div class="who"><b>' + esc(p.name) + '</b><span>' + esc(teamLabel(p)) + (p.move !== null ? ' · ' + moveHtml(p.move) : '') + '</span></div></td>' +
        cells + '<td class="r num">' + fmt(p.avg) + '</td><td class="r num" style="font-weight:900">' + fmt(p.total) + '</td></tr>';
    }).join("");
  }
  search.addEventListener("input", renderPeople);
  filter.addEventListener("change", renderPeople);
 
  // =====================================================================
  //  Boot: load the sheet, fall back to sample data if it can't be reached
  // =====================================================================
  var notice = document.getElementById("notice"), loaded = false;
  function apply(model, fromSheet) {
    var keepMode = mode;
    setModel(model);
    renderHeader(new Date(), fromSheet);
    renderStats(); fillFilter(); renderPeople();
    if (!replaying) setMode(keepMode);
  }
  function refresh() {
    return loadSheet().then(function (model) {
      apply(model, true); loaded = true; notice.hidden = true;
    }).catch(function (err) {
      if (loaded) return; // keep showing the last good data
      apply(snapshotModel(), false);
      notice.hidden = false;
      notice.innerHTML = "<strong>Showing a saved copy of the week 1 results.</strong> " + esc(err && err.message ? err.message : "Couldn't load the Google Sheet.") +
        " Once the page is on your website, the live numbers load here automatically.";
    });
  }
  document.getElementById("stats").innerHTML = '<div class="stat s-sun"><b>Loading the latest steps…</b></div>';
  refresh();
  setInterval(function () { if (!replaying) refresh(); }, REFRESH_MINUTES * 60 * 1000);
  window.addEventListener("resize", function () { if (tipEnt) positionTip(tipEnt); });
})();
</script>
 
