<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>SSUK Step Challenge 2026</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap">
<style>
/* Single light theme by design. Layout: one column dashboard — stats, a wide landscape race map (individuals or teams), then two scrollable leaderboards. */
:root {
  --bg: #F3F7FA;
  --surface: #FFFFFF;
  --surface-2: #F6F9FC;
  --ink: #223040;
  --muted: #566677;
  --line: #E2E9F0;
  --sea: #D3E9F6;
  --land: #EAF2E0;
  --coast: #FFFFFF;
  --border: #AFC2A3;
  --route: #E2583A;
  --route-soft: #F2A28F;
  --sun: #FFC845;
  --good: #1B7A5E;
  --bad: #B3261E;
  --t-sun: #FFF3D1; --t-sun-ink: #6B5310;
  --t-mint: #DCF2EA; --t-mint-ink: #1B5E50;
  --t-sky: #E2ECFB; --t-sky-ink: #1F4D8F;
  --t-coral: #FFE3DA; --t-coral-ink: #8F2F18;
  --pin-other: #8396AA;
  --shadow: 0 1px 2px rgba(34,48,64,.06), 0 6px 20px rgba(34,48,64,.06);
  color-scheme: light;
  --font: "Nunito", ui-rounded, "SF Pro Rounded", system-ui, -apple-system, "Segoe UI", sans-serif;
}
* { box-sizing: border-box; }
body { background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 15px; line-height: 1.45; }
.wrap { max-width: 1280px; margin: 0 auto; padding-inline: 20px; padding-block: 28px 56px; display: flex; flex-direction: column; gap: 24px; }
h1, h2, h3 { margin: 0; text-wrap: balance; }
button, input, select { font: inherit; color: inherit; }
:focus-visible { outline: 3px solid var(--sun); outline-offset: 2px; }
.num { font-variant-numeric: tabular-nums; }
 
/* Header */
.top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 18px; }
.title-block { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.live-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; color: var(--muted); font-size: 14px; }
.live { display: inline-flex; align-items: center; gap: 8px; background: var(--t-coral); color: var(--t-coral-ink); font-weight: 800; font-size: 12px; letter-spacing: .12em; padding: 5px 12px; border-radius: 999px; }
.live i { width: 8px; height: 8px; border-radius: 50%; background: var(--route); animation: pulse 1.6s ease-out infinite; }
@keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(226,88,58,.55); } 70% { box-shadow: 0 0 0 9px rgba(226,88,58,0); } 100% { box-shadow: 0 0 0 0 rgba(226,88,58,0); } }
h1 { font-size: clamp(36px, 6vw, 58px); font-weight: 900; line-height: 1.02; letter-spacing: -.02em; }
.sub { margin: 0; color: var(--muted); font-size: 17px; }
.day-card { background: var(--surface); border-radius: 18px; padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; min-width: min(300px, 100%); box-shadow: var(--shadow); }
.day-card .row { display: flex; justify-content: space-between; gap: 12px; font-weight: 800; }
.day-card .row span:last-child { color: var(--muted); font-weight: 600; }
.day-card .dates { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: var(--muted); }
.track { height: 10px; background: var(--line); border-radius: 999px; overflow: hidden; }
.track > i { display: block; height: 100%; border-radius: 999px; background: var(--sun); }
 
/* Stat cards */
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
.stat { border-radius: 18px; padding: 16px 18px; display: flex; flex-direction: column; gap: 2px; }
.stat b { font-size: 14px; font-weight: 800; }
.stat strong { font-size: 34px; font-weight: 900; line-height: 1.1; color: var(--ink); }
.stat strong.name { font-size: 26px; }
.stat span { font-size: 14px; }
.s-sun { background: var(--t-sun); color: var(--t-sun-ink); }
.s-mint { background: var(--t-mint); color: var(--t-mint-ink); }
.s-sky { background: var(--t-sky); color: var(--t-sky-ink); }
.s-coral { background: var(--t-coral); color: var(--t-coral-ink); }
 
/* Panels */
.panel { background: var(--surface); border-radius: 26px; padding: 22px; display: flex; flex-direction: column; gap: 16px; box-shadow: var(--shadow); min-width: 0; }
.panel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px; }
.panel-head h2 { font-size: 28px; font-weight: 900; }
.panel-head p { margin: 2px 0 0; color: var(--muted); max-width: 62ch; }
.controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.seg { display: inline-flex; gap: 3px; padding: 3px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 999px; }
.seg button { border: 0; background: transparent; min-height: 40px; padding: 0 16px; border-radius: 999px; font-weight: 800; color: var(--muted); cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 4px rgba(34,48,64,.15); }
.seg button:disabled { cursor: default; opacity: .6; }
.seg.big button { min-height: 44px; padding: 0 20px; font-size: 16px; }
.seg.big button[aria-pressed="true"] { background: var(--ink); color: var(--surface); }
.btn { border: 0; min-height: 44px; padding: 0 18px; border-radius: 999px; background: var(--route); color: #FFFFFF; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
.btn:disabled { opacity: .55; cursor: default; }
.field { min-height: 44px; border: 1px solid var(--line); background: var(--surface-2); border-radius: 999px; padding: 0 16px; min-width: 0; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.map-tools { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; align-items: center; }
.route-line { font-size: 15px; color: var(--muted); }
.route-line strong { color: var(--ink); }
 
/* Map */
.map-box { position: relative; width: 100%; max-width: 100%; aspect-ratio: 1146 / 800; border-radius: 20px; overflow: hidden; background: var(--sea); }
.map-box svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
.land { fill: var(--land); }
.sea { fill: var(--sea); stroke: var(--coast); stroke-width: 1.5; stroke-linejoin: round; }
.island { fill: var(--land); stroke: var(--coast); stroke-width: 1.5; stroke-linejoin: round; }
.border { fill: none; stroke: var(--border); stroke-width: 1.3; stroke-dasharray: 5 3; stroke-linejoin: round; stroke-linecap: round; }
.ov { position: absolute; inset: 0; pointer-events: none; }
.country { position: absolute; transform: translate(-50%, -50%); font-size: 11px; font-weight: 900; letter-spacing: .18em; color: var(--muted); opacity: .55; white-space: nowrap; }
.country.minor { font-size: 9px; letter-spacing: .12em; }
.city { position: absolute; width: 0; height: 0; }
.city i { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--surface); border: 2px solid var(--ink); }
.city.start i, .city.end i { width: 14px; height: 14px; margin: -7px 0 0 -7px; background: var(--ink); border-color: var(--surface); }
.city span { position: absolute; font-size: 12px; font-weight: 800; white-space: nowrap; color: var(--ink); line-height: 1.15; text-shadow: 0 0 3px var(--land), 0 0 3px var(--land), 0 0 3px var(--land); }
.city span small { display: block; font-size: 10px; font-weight: 700; color: var(--muted); }
.pin { pointer-events: auto; position: absolute; width: 18px; height: 18px; margin: -9px 0 0 -9px; padding: 0; border-radius: 6px; border: 2px solid var(--surface); background: var(--pin-other); color: #FFFFFF; font-size: 9px; font-weight: 900; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 2; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
.pin.dot { width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; border-width: 2px; font-size: 0; opacity: .85; }
.pin.top { width: 28px; height: 28px; margin: -14px 0 0 -14px; border-radius: 9px; border-width: 3px; font-size: 13px; z-index: 4; opacity: 1; }
.pin.round.top { border-radius: 50%; }
.pin.sel { z-index: 6; transform: scale(1.2); opacity: 1; }
.stem { position: absolute; width: 2px; margin-left: -1px; z-index: 3; }
.plabel { position: absolute; transform: translateX(-50%); background: var(--surface); border: 2px solid; border-radius: 999px; padding: 1px 9px; font-size: 12px; font-weight: 900; white-space: nowrap; z-index: 5; }
.tip { position: absolute; z-index: 10; pointer-events: none; background: var(--surface); color: var(--ink); border-radius: 14px; padding: 10px 12px; box-shadow: 0 6px 24px rgba(0,0,0,.18); font-size: 13px; min-width: 190px; max-width: 250px; }
.tip b { display: block; font-size: 15px; }
.tip .tmuted { color: var(--muted); }
.day-badge { position: absolute; left: 14px; top: 14px; background: var(--surface); border-radius: 999px; padding: 6px 14px; font-weight: 900; font-size: 14px; box-shadow: var(--shadow); z-index: 8; }
.map-foot { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--muted); font-size: 14px; }
.map-foot strong { color: var(--ink); }
.key { display: inline-flex; align-items: center; gap: 6px; }
.key i { width: 14px; height: 14px; border-radius: 4px; display: inline-block; }
 
/* Scroll lists */
.scroller { max-height: 520px; overflow: auto; border: 1px solid var(--line); border-radius: 18px; overscroll-behavior: contain; }
.count { color: var(--muted); font-size: 14px; }
 
/* Team list */
.team { border-bottom: 1px solid var(--line); }
.team:last-child { border-bottom: 0; }
.team-row { width: 100%; border: 0; background: transparent; text-align: left; cursor: pointer; display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 12px 16px; }
.team-row:hover { background: var(--surface-2); }
.team.sel .team-row { background: var(--t-sky); }
.badge { width: 36px; height: 36px; border-radius: 11px; display: flex; align-items: center; justify-content: center; font-weight: 900; color: #FFFFFF; background: var(--pin-other); }
.t-main { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.t-name { font-weight: 800; font-size: 16px; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
.t-name small { font-weight: 600; font-size: 13px; color: var(--muted); }
.t-where { font-size: 13px; color: var(--muted); }
.bar { height: 8px; background: var(--line); border-radius: 999px; overflow: hidden; }
.bar > i { display: block; height: 100%; border-radius: 999px; }
.t-nums { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
.t-nums strong { font-size: 17px; font-weight: 900; }
.t-nums span { font-size: 13px; color: var(--muted); }
.move { font-size: 12px; font-weight: 800; }
.up { color: var(--good); } .down { color: var(--bad); } .same { color: var(--muted); }
.members { padding: 4px 16px 14px 66px; display: grid; gap: 8px; }
.member { display: grid; grid-template-columns: minmax(0, 1fr) 90px; gap: 10px; align-items: center; font-size: 14px; }
.member .bar { height: 6px; }
.member > div:first-child { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.member > span { text-align: right; font-weight: 800; }
 
/* People table */
table { width: 100%; border-collapse: collapse; min-width: 760px; }
thead th { position: sticky; top: 0; z-index: 1; background: var(--surface); text-align: left; font-size: 12px; font-weight: 800; color: var(--muted); padding: 10px 12px; border-bottom: 1px solid var(--line); white-space: nowrap; }
thead th small { display: block; font-weight: 600; font-size: 11px; }
th.r, td.r { text-align: right; }
tbody td { padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr.flash td { animation: flash 1.4s ease-out; }
@keyframes flash { 0%, 40% { background: var(--t-sky); } 100% { background: transparent; } }
td.pending { color: var(--muted); font-size: 13px; font-weight: 700; opacity: .7; }
.rank { width: 32px; height: 32px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 900; font-size: 14px; background: var(--surface-2); }
.r1 { background: #FFC845; color: #223040; } .r2 { background: #D5DEE7; color: #223040; } .r3 { background: #F2C4A8; color: #223040; }
.who { display: flex; flex-direction: column; }
.who b { font-weight: 800; }
.who span { font-size: 13px; color: var(--muted); }
.who button { border: 0; background: none; padding: 0; text-align: left; cursor: pointer; font-weight: 800; }
.who button:hover { text-decoration: underline; }
.empty { padding: 28px; text-align: center; color: var(--muted); }
.notice { background: var(--t-sun); color: var(--t-sun-ink); border-radius: 16px; padding: 12px 16px; font-size: 14px; }
.notice strong { color: var(--ink); }
.foot { text-align: center; color: var(--muted); font-size: 13px; margin: 0; }
 
@media (max-width: 640px) {
  .panel { padding: 16px; border-radius: 20px; }
  .members { padding-left: 16px; }
  .city span { font-size: 10px; }
  .country { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .live i { animation: none; }
  tbody tr.flash td { animation: none; }
}
</style>
 
<style>html,body{margin:0}img{max-width:100%}[hidden]{display:none!important}</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="title-block">
      <div class="live-row"><span class="live"><i></i><span id="weekPill">WEEK 1 RESULTS IN</span></span><span id="nextUpdate"></span></div>
      <h1>SSUK Step Challenge 2026</h1>
      <p class="sub">28 September – 25 October 2026 · teams of up to 5 · steps reported weekly</p>
    </div>
    <div class="day-card">
      <div class="row"><span id="dayLabel">Day 1 of 28</span><span id="daysLeft"></span></div>
      <div class="track"><i id="dayBar"></i></div>
      <div class="dates"><span>Mon 28 Sep</span><span>Sun 25 Oct</span></div>
    </div>
  </header>
 
  <div class="notice" id="notice" role="status" hidden></div>
 
  <section class="stats" id="stats" aria-label="Challenge totals"></section>
 
  <section class="panel" aria-labelledby="mapTitle">
    <div class="panel-head">
      <div>
        <h2 id="mapTitle">Race around the world</h2>
        <p id="mapDesc"></p>
      </div>
      <div class="seg big" role="group" aria-label="Race to show">
        <button type="button" id="modeSolo" aria-pressed="true">Individuals</button>
        <button type="button" id="modeTeam" aria-pressed="false">Teams</button>
      </div>
    </div>
    <div class="map-tools">
      <span class="route-line" id="routeLine"></span>
      <div class="controls">
        <div class="seg" role="group" aria-label="Map view">
          <button type="button" id="viewAll" aria-pressed="true">Whole route</button>
          <button type="button" id="viewPack" aria-pressed="false">Zoom to the pack</button>
        </div>
        <button type="button" class="btn" id="replay">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" fill="currentColor"></path></svg>
          Replay the race
        </button>
      </div>
    </div>
    <div class="map-box" id="mapBox">
      <svg id="map" viewBox="0 0 1146 800" preserveAspectRatio="none" role="img" aria-label="Race map">
        <rect class="land" x="-2000" y="-2000" width="6000" height="6000"></rect>
        <g id="borders"></g>
        <g id="water"></g>
        <g id="bordersTop"></g>
        <polyline id="routeBase" fill="none" stroke="var(--coast)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
        <polyline id="routeDash" fill="none" stroke="var(--route-soft)" stroke-width="3" stroke-dasharray="2 8" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
        <polyline id="routeDone" fill="none" stroke="var(--route)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
      </svg>
      <div class="ov" id="ovStatic"></div>
      <div class="ov" id="ovPins"></div>
      <div class="day-badge" id="dayBadge" hidden>Day 1</div>
      <div class="tip" id="tip" hidden></div>
    </div>
    <div class="map-foot">
      <span><strong>1 step ≈ 0.75 m.</strong> Replay spreads each weekly total evenly across its 7 days.</span>
      <span class="key"><i style="background: var(--route)"></i>Leader's trail</span>
      <span>Hover or tap a pin to see who it is.</span>
    </div>
  </section>
 
  <section class="panel" aria-labelledby="teamTitle">
    <div class="panel-head">
      <div>
        <h2 id="teamTitle">Team leaderboard</h2>
        <p>Total steps of every member. Tap a team to see its walkers.</p>
      </div>
      <span class="count" id="teamCount"></span>
    </div>
    <div class="scroller" id="teamList"></div>
  </section>
 
  <section class="panel" aria-labelledby="peopleTitle">
    <div class="panel-head">
      <div>
        <h2 id="peopleTitle">Individual leaderboard</h2>
        <p>Everyone's reported steps, week by week, including people walking on their own. Ranked by total so far.</p>
      </div>
      <div class="controls">
        <label class="sr" for="peopleSearch">Search walkers</label>
        <input class="field" id="peopleSearch" type="search" placeholder="Search names">
        <label class="sr" for="teamFilter">Filter by team</label>
        <select class="field" id="teamFilter"><option value="">All walkers</option></select>
      </div>
    </div>
    <div class="scroller" id="peopleWrap">
      <table>
        <thead><tr id="peopleHead"></tr></thead>
        <tbody id="peopleBody"></tbody>
      </table>
    </div>
    <span class="count" id="peopleCount"></span>
  </section>
 
  <p class="foot">Steps come from the SSUK Step Challenge sheet and refresh every 10 minutes. Teams report weekly.</p>
</div>
 
<script>
(function () {
  "use strict";
 
  // =====================================================================
  //  DATA SOURCE — the SSUK step challenge Google Sheet
  //  The sheet must be shared as "Anyone with the link: Viewer"
  //  (or published via File → Share → Publish to web).
  //  It holds two tables on one tab: "Teams" and "People".
  // =====================================================================
  var SHEET_ID = "1GYPCvD7jUilbRuFVeM3tydtnVJxwSlzRLoxP4qgHonY";
  var SHEET_GID = "0";
  // Optional: paste a "Publish to web" CSV link here and it will be used first.
  var PUBLISHED_CSV_URL = "";
  var REFRESH_MINUTES = 10;
 
  // ---------- Challenge calendar ----------
  var START = Date.UTC(2026, 8, 28);           // Mon 28 Sep 2026
  var DAYS = 28, WEEKS = 4, DAY_MS = 864e5;     // ends Sun 25 Oct 2026
  var KM_PER_STEP = 0.00075;
  var COLORS = ["#E0532F", "#138A7D", "#6A4BC9", "#B86E00", "#2468C9"];
  var MON = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  var DOW = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  var fmt = function (n) { return Math.round(n).toLocaleString("en-GB"); };
  var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };
  function dateAt(offset, withDay) { var d = new Date(START + offset * DAY_MS); return (withDay ? DOW[d.getUTCDay()] + " " : "") + d.getUTCDate() + " " + MON[d.getUTCMonth()]; }
  var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
 
  // Day progress (from today's date)
  (function () {
    var now = new Date(), todayUTC = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
    var dayIdx = Math.round((todayUTC - START) / DAY_MS);
    var label = document.getElementById("dayLabel"), left = document.getElementById("daysLeft"), bar = document.getElementById("dayBar");
    if (dayIdx < 0) { label.textContent = "Starts Mon 28 Sep"; left.textContent = (-dayIdx) + (dayIdx === -1 ? " day" : " days") + " to go"; bar.style.width = "0%"; }
    else if (dayIdx >= DAYS) { label.textContent = "Challenge complete"; left.textContent = "28 of 28 days"; bar.style.width = "100%"; }
    else {
      var dayNum = dayIdx + 1, remaining = DAYS - dayNum;
      label.textContent = "Day " + dayNum + " of " + DAYS;
      left.textContent = remaining === 0 ? "Final day" : remaining + (remaining === 1 ? " day" : " days") + " to go";
      bar.style.width = (dayNum / DAYS * 100).toFixed(1) + "%";
    }
  })();
 
  // ---------- Map projection ----------
  var LON0 = -7, LAT0 = 57, K = 40, CX = Math.cos(47 * Math.PI / 180);
  var MW = 1146, MH = 800;
  function P(lat, lon) { return [(lon - LON0) * CX * K, (LAT0 - lat) * K]; }
  function pathD(pts, close) { return "M" + pts.map(function (p) { var q = P(p[0], p[1]); return q[0].toFixed(2) + " " + q[1].toFixed(2); }).join(" L") + (close ? " Z" : ""); }
 
  // Stylised coastlines (lat, lon)
